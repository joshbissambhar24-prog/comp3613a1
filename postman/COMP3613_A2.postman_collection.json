    {
      "name": "Resubmit updated research",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "title", "value": "Updated Research", "type": "text" },
            { "key": "description", "value": "Corrected research after feedback", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/submissions/{{submissionId}}/resubmit",
          "host": ["{{baseUrl}}"],
          "path": ["submissions", "{{submissionId}}", "resubmit"]
        }
      },
