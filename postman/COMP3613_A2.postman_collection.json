      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected response\", function () {",
              "  pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login student",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "username", "value": "{{studentUsername}}", "type": "text" },
            { "key": "password", "value": "{{studentPassword}}", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Sign-in succeeded\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200,303]);",
              "  pm.expect(pm.cookies.has(\"access_token\")).to.equal(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create research submission",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"API test poster\", \"description\": \"Integration test research\", \"research_type\": \"Poster\"}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/submissions",
          "host": ["{{baseUrl}}"],
          "path": ["api", "submissions"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected response\", function () { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql(\"Pending\"); });",
              "pm.collectionVariables.set(\"submissionId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
