        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Resubmission succeeds\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 303]);",
              "    });"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify resubmission",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/submissions/{{submissionId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "submissions", "{{submissionId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Research returned to Pending\", function () {",
              "    pm.response.to.have.status(200);",
              "",
              "    const submission = pm.response.json();",
              "",
              "    pm.expect(submission.status).to.eql(\"Pending\");",
              "    pm.expect(submission.title).to.eql(\"Updated Research\");",
              "    pm.expect(submission.description).to.eql(\"Corrected research after feedback\");",
              "    });"
            ]
          }
        }
      ]
